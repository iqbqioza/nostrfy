# systemd unit for running nostrfy on a VM (see docs/deploy/).
# Copy to /etc/systemd/system/nostrfy.service, adjust the config path,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now nostrfy
#
# Foreground mode is deliberate: systemd supervises the relay process
# directly, so there is no fork/readiness race (a large database or group
# rebuild may take longer than the CLI's 10 s daemon probe) and no PIDFile
# to keep in sync with daemon.pid_file. Use the user unit for systemd --user.

[Unit]
Description=nostrfy Nostr relay server
After=network-online.target
Wants=network-online.target

[Service]
# The relay accepts untrusted network traffic and needs no privileges: run
# it as an unprivileged system user. Create it once with a home directory
# for relative paths:
#   sudo useradd --system --create-home --home /var/lib/nostrfy nostrfy
# Relative config paths (e.g. database.path = "./data") then resolve under
# /var/lib/nostrfy. When migrating an existing install, move the data and
# chown it: sudo chown -R nostrfy:nostrfy /var/lib/nostrfy
User=nostrfy
Group=nostrfy
WorkingDirectory=/var/lib/nostrfy
Type=simple
ExecStart=/usr/local/bin/nostrfy --config /etc/nostrfy/nostrfy.toml start --foreground
Restart=always
RestartSec=5
# Every connection (and every live WebSocket) holds a file descriptor, and
# the systemd default of 1024 is far below the default
# `limits.max_connections = 10000`: without this the relay hits EMFILE and
# refuses connections under load. 2x the connection budget plus headroom.
LimitNOFILE=65536
# Harden the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# NIP-86 changerelayname/description/icon persist into this file. The mount
# must be writable, and the nostrfy user must own the file:
#   sudo chown nostrfy:nostrfy /etc/nostrfy/nostrfy.toml
ReadWritePaths=/etc/nostrfy
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
